    "linter",
    "ai",
    "llm",
    "prompt-engineering",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sidhxntt/Vibe-Coding-Bundle.git",
    "directory": "vibe_linter"
  },
  "homepage": "https://github.com/sidhxntt/Vibe-Coding-Bundle/tree/main/vibe_linter#readme",
  "bugs": {
    "url": "https://github.com/sidhxntt/Vibe-Coding-Bundle/issues"
  },
  "author": "Siddhant Gupta <siddhant@invytt.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
