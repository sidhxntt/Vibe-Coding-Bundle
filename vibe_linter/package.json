{
  "name": "@sidhxntt/vibe-lint",
  "version": "2.0.0",
  "description": "A linter for your prompts — flags weak, vague, and contradictory instructions",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "@sidhxntt/vibe-lint": "./src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "start": "node ./src/index.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@sidhxntt/prompt-rules": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
